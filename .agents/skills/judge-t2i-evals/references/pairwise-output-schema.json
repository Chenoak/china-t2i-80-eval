{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pairwise-output-schema-v1",
  "title": "Pairwise text-to-image Judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pair_run_id", "task_id", "winner", "reason"],
  "properties": {
    "schema_version": {"const": "pairwise-output-v1"},
    "pair_run_id": {"type": "string", "pattern": "^Q[0-9]{3}-P[0-9]{2}-(LR|RL)$"},
    "task_id": {"type": "string", "pattern": "^Q(00[1-9]|0[1-7][0-9]|080)$"},
    "winner": {"enum": ["LEFT", "RIGHT", "TIE", "BOTH_FAIL", "UNCERTAIN"]},
    "reason": {"type": "string", "minLength": 1},
    "dimension_winners": {
      "type": "object",
      "additionalProperties": {"enum": ["LEFT", "RIGHT", "TIE", "UNCERTAIN"]}
    }
  }
}
